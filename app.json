{
  "expo": {
    "name": "SmartBozor",
    "slug": "smartbozor",
    "version": "1.23.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "runtimeVersion": "1.20.0",
    "updates": {
      "url": "https://u.expo.dev/b920875c-9c46-4d44-bda7-8aae94235ce1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.temurmalik.shopapp",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SmartBozor profil rasmingizni yuklash va saqlash uchun galereyangizdan foydalanadi.",
        "NSCameraUsageDescription": "SmartBozor profil rasmingizni olish uchun kameradan foydalanadi.",
        "NSLocationWhenInUseUsageDescription": "SmartBozor buyurtmalaringizni tez va aniq yetkazib berish uchun geolokatsiyangizdan foydalanadi.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.temurmalik.shopapp",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SmartBozor buyurtmalaringizni tez va aniq yetkazib berish uchun geolokatsiyangizdan foydalanadi."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SmartBozor profil rasmingizni yuklash uchun galereyangizdan foydalanadi.",
          "cameraPermission": "SmartBozor profil rasmingizni olish uchun kameradan foydalanadi."
        }
      ],
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "b920875c-9c46-4d44-bda7-8aae94235ce1"
      }
    }
  }
}
